# Supabase Configuration for LifeOS
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only UUID from Supabase Authentication > Users. Must match the database
# private_app_owner row. Protected access is denied until both are configured.
LIFEOS_OWNER_ID=your-auth-user-uuid
